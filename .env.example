# ============================================================
# CertifiedBlockchain environment template
#
# Copy this file to .env and fill in the values:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# .env is gitignored - never commit real keys or addresses you
# don't want public.
# ============================================================

# --- Frontend (Vite) ----------------------------------------
# Chain ID the dApps run on: 11155111 = Sepolia testnet
VITE_NETWORK_ID=11155111

# Deployed contract addresses (see README.md deployment table)
VITE_ADOPTION_ADDRESS=
VITE_AUCTION_ADDRESS=
VITE_CERTIFICATE_ADDRESS=
VITE_CHATBOXPLUS_ADDRESS=
VITE_CRYPTODOGGIES_ADDRESS=
VITE_DAPPTOKEN_ADDRESS=
VITE_DAPPTOKENSALE_ADDRESS=
VITE_EMAIL_ADDRESS=
VITE_GUESSINGGAME_ADDRESS=
VITE_POLL_ADDRESS=
VITE_TASK_ADDRESS=
VITE_TICKETSALE_ADDRESS=
VITE_TICTACTOE_ADDRESS=
VITE_VOTING_ADDRESS=
VITE_WEIGHTEDVOTING_ADDRESS=
VITE_EXCHANGE_ADDRESS=

# --- Hardhat deployment (hardHat/hardhat.config.js reads this file) ---
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=

# TokenForge factory (set after running scripts/deploy-tokenforge.js)
VITE_TOKENFORGE_FACTORY_ADDRESS=
